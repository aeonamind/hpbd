# =====================================================================
#  Cấu hình trang sinh nhật. Đổi ở đây rồi khởi động lại server / pod.
#
#  Quy tắc (để dùng được cho cả node, docker --env-file và kubectl/kustomize):
#   - Mỗi biến MỘT dòng, dạng KEY=giá trị, KHÔNG cần dấu ngoặc kép.
#   - Danh sách (INTRO, WISHES, PHOTOS) ngăn cách bằng dấu |
#   - Xuống dòng trong đoạn văn (LETTER, FINAL_MESSAGE) viết là \n
#   - Placeholder: {name} = tên cô ấy, {from} = tên bạn, {age} = tuổi
#   - File phải lưu dạng UTF-8.
# =====================================================================

HER_NAME=Minh Thư
FROM_NAME=Anh
AGE=17
PAGE_TITLE=Sinh nhật vui vẻ, {name} 🎂

# Khóa trang tới giờ sinh nhật, ví dụ 2026-11-20T00:00:00+07:00 (để trống = không khóa).
# Thêm ?preview vào cuối link để tự xem trước.
UNLOCK_AT=

# Nhạc riêng: bỏ file vào public/ rồi ghi tên, ví dụ music.mp3. Trống = nhạc hộp nhạc tự tạo.
MUSIC=

INTRO=Hôm nay là một ngày đặc biệt...|vì đúng {age} năm trước, {name} ra đời.|Chúc mừng em đã chính thức bước sang tuổi {age}!|Anh có chuẩn bị một món quà nho nhỏ cho em đây. 🎁

LETTER=Gửi {name},\n\nChúc mừng sinh nhật em! {age} tuổi rồi đấy, lớn thật rồi.\n\nNăm nay chắc em sẽ bận hơn nhiều: học hành, thi cử, rồi bắt đầu nghĩ đến chuyện sau này. Cứ cố gắng hết sức, nhưng cũng nhớ nghỉ ngơi đúng lúc, đừng ép mình quá.\n\nAnh chúc em tuổi mới thật khỏe mạnh, học tốt, có nhiều bạn bè vui vẻ và luôn giữ được sự vui tươi của mình. Gặp chuyện gì khó thì cứ bình tĩnh, rồi mọi chuyện cũng sẽ ổn thôi.\n\nSinh nhật vui vẻ nhé, {name}! 🎂

WISHES_TITLE={age} điều anh chúc em
WISHES=Chúc em tuổi {age} thật nhiều niềm vui.|Chúc em luôn khỏe mạnh, ít ốm vặt.|Chúc em học tốt, thi đâu đỗ đó.|Chúc em ngủ đủ giấc, bớt thức khuya.|Chúc em ăn gì cũng thấy ngon.|Chúc em có nhiều bạn bè tốt.|Chúc em tự tin hơn mỗi ngày.|Chúc em tìm được điều mình thật sự thích làm.|Chúc em có nhiều chuyến đi chơi vui.|Chúc gia đình em luôn mạnh khỏe, bình an.|Chúc em gặp chuyện khó cũng bình tĩnh vượt qua.|Chúc em điểm cao mà không phải học quá sức.|Chúc em luôn vui vẻ và lạc quan.|Chúc em có thật nhiều kỷ niệm đẹp ở tuổi {age}.|Chúc mọi dự định của em đều suôn sẻ.|Chúc em luôn là chính mình.|Và chúc em có một ngày sinh nhật thật vui! 🎉

# Ảnh kỷ niệm: bỏ ảnh vào public/photos/, mỗi ảnh dạng đường_dẫn::chú thích, ngăn cách bằng |
# Ví dụ: PHOTOS=photos/1.jpg::Lần đầu đi chơi|photos/2.jpg::Cậu cười xinh ghê
PHOTOS=

FINAL_TITLE=Chúc mừng sinh nhật, {name}!
FINAL_MESSAGE=Chúc em tuổi {age} thật nhiều niềm vui và may mắn.\nSinh nhật vui vẻ nhé! 🎂

# 🔔 Theo dõi: server chuyển tiếp từng bước cô ấy xem về app ntfy trên điện thoại bạn.
# Topic giờ chỉ nằm ở server, trình duyệt không thấy. Để trống = chỉ ghi log server, không push.
TRACK_TOPIC=
# Nếu bạn tự host ntfy trong cụm thì đổi URL, ví dụ http://ntfy.ntfy.svc.cluster.local
NTFY_URL=https://ntfy.sh

PORT=8080
